# PRODUCTION settings (YGH-104, YGH-106). Copy to `.env.production` (git-ignored), fill in EVERY
# value, and use it with docker-compose.prod.yml. Never commit the filled-in file.
#
# Nothing is defaulted. The API refuses to start if (see Settings.production_problems):
#   - JWT_SECRET is the development default or shorter than 32 characters
#   - the database URL still contains the development password
#   - CORS_ORIGINS is empty or "*"
#   - STORAGE_DIR is not an absolute path
#   - a hosted LLM_PROVIDER has no API key
#
# Make a secret:   python -c "import secrets; print(secrets.token_urlsafe(48))"

POSTGRES_USER=phi
POSTGRES_DB=phi
POSTGRES_PASSWORD=                      # long and random; never the development one

JWT_SECRET=                             # long and random (at least 32 characters)

# The web app's public origin, as a JSON list, and the API's public address as the browser sees it
# (inlined into the web bundle at build time).
CORS_ORIGINS=["https://app.example.com"]
NEXT_PUBLIC_API_URL=https://api.example.com

# The model. ollama = one you run yourself; openai/grok = a hosted service that is sent each
# question and its evidence (docs/08_PRIVACY.md, section 4).
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
# OPENAI_API_KEY=
# XAI_API_KEY=

LOG_LEVEL=INFO
# API_PORT=8000
# WEB_PORT=3000
