# TEST settings (YGH-104). The tests need none of this: the defaults work against the compose
# Postgres. These exist to be overridden, for example in CI or against another database.
ENVIRONMENT=test

# The integration tests (tests/integration) drop and rebuild THIS database from zero with the real
# Alembic migrations. Its name must end in `_test`: the tests refuse anything else, so they can
# never touch the development or production database.
TEST_DATABASE_URL=postgresql+psycopg://phi:phi_dev_password@localhost:5433/phi_integration_test

# CI sets this so a missing Postgres FAILS the integration tests instead of skipping them.
# REQUIRE_POSTGRES=1

# No language model is needed: the tests script it. No OPENAI_API_KEY / XAI_API_KEY either.
