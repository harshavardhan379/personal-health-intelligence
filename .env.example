# DEVELOPMENT settings (YGH-104). Copy to `.env` (git-ignored) and adjust; every value has a working
# default for local development, so the file is optional. The same names are read from real
# environment variables, which win over the file.
#
# Three environments, one set of names:
#   development   this file's defaults: local Postgres (docker compose), local Ollama, API docs on
#   test          the automated tests: `ENVIRONMENT=test`, see .env.test.example
#   production    .env.production.example: nothing is defaulted, unsafe values stop the app

ENVIRONMENT=development
LOG_LEVEL=INFO

# Postgres from `docker compose up postgres` (host port 5433, not 5432: a native Windows Postgres
# service often owns 5432).
DATABASE_URL=postgresql+psycopg://phi:phi_dev_password@localhost:5433/phi

# Development-only. Production refuses this value.
JWT_SECRET=dev-only-secret-change-me
# JWT_EXPIRE_MINUTES=1440

CORS_ORIGINS=["http://localhost:3000"]
STORAGE_DIR=storage

# The assistant's model: ollama (local, the default) | openai | grok. A hosted provider is sent the
# question and the evidence text of each call: read docs/08_PRIVACY.md, section 4.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# OPENAI_API_KEY=
# XAI_API_KEY=

# The web app (apps/web/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8000
