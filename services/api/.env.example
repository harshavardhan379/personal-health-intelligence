ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
STORAGE_DIR=storage

# LLM provider (YGH-83): "openai" | "grok" | "ollama"
LLM_PROVIDER=ollama

# Only needed if LLM_PROVIDER=openai. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Only needed if LLM_PROVIDER=grok. Never commit a real key.
XAI_API_KEY=
XAI_MODEL=grok-2-latest

# Only used if LLM_PROVIDER=ollama. No key needed — requires `ollama serve`
# running locally with OLLAMA_MODEL already pulled (`ollama pull llama3.2:3b`).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
